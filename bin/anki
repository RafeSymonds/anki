#!/usr/bin/env bash
# Lifecycle for the Anki desktop app (Tauri shell in desktop/).
#
#   bin/anki start [--build]   build (web assets only with --build) and launch
#   bin/anki stop              quit the running app
#   bin/anki restart           stop, rebuild everything, start
#   bin/anki status            report whether it is running
#   bin/anki build             build web assets and the app without launching
#   bin/anki logs              tail the app log
#   bin/anki serve [port] [--fresh]   serve over loopback HTTP (no window); --fresh uses a
#                              throwaway seeded collection under out/anki-e2e-base
#   bin/anki e2e               run the Playwright end-to-end tests against `serve`
#   bin/anki sveltekit         rebuild only the SvelteKit app (the shell) without ninja
#   bin/anki e2e-quick [port] [playwright args]   e2e without rebuilding assets
#   bin/anki worktree-init     prepare out/ in a git worktree (shares heavy deps with the main checkout)
#   bin/anki package [--universal]    build a self-contained Anki.app and .dmg (target/release/bundle)
#   bin/anki release <version> build and publish that version on GitHub (Actions does the work)
#   bin/anki bench [port]      measure cold start and backend call latency in HTTP mode
#
# Env: ANKI_BASE (profile folder), ANKI_START_ROUTE (page to open, e.g. /congrats)

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PIDFILE="$ROOT/out/anki-desktop.pid"
LOG="$ROOT/out/anki-desktop.log"
BIN="$ROOT/target/debug/anki-desktop"

cd "$ROOT"

# Where profiles live. Defaults to a throwaway folder inside out/ so a dev
# build never touches the real collection by accident. Point ANKI_BASE at
# "$HOME/Library/Application Support/Anki2" to use the Qt app's data.
export ANKI_BASE="${ANKI_BASE:-$ROOT/out/anki-dev-base}"

build_web() {
    echo "==> building web assets"
    just web
}

build_app() {
    echo "==> building desktop app"
    cargo build -p anki-desktop
}

pid() {
    [[ -f "$PIDFILE" ]] && cat "$PIDFILE" || true
}

is_running() {
    local p
    p="$(pid)"
    [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null
}

start() {
    local build=0
    [[ "${1:-}" == "--build" ]] && build=1
    if is_running; then
        echo "already running (pid $(pid))"
        return 0
    fi
    if [[ $build -eq 1 || ! -d "$ROOT/out/sveltekit" ]]; then
        build_web
    fi
    build_app
    mkdir -p "$ROOT/out"
    nohup "$BIN" >"$LOG" 2>&1 &
    echo $! >"$PIDFILE"
    sleep 1
    if is_running; then
        echo "started (pid $(pid)), base: $ANKI_BASE, log: $LOG"
    else
        echo "failed to start; last log lines:" >&2
        tail -n 20 "$LOG" >&2
        rm -f "$PIDFILE"
        return 1
    fi
}

stop() {
    if ! is_running; then
        echo "not running"
        rm -f "$PIDFILE"
        return 0
    fi
    local p
    p="$(pid)"
    kill "$p"
    for _ in $(seq 1 50); do
        kill -0 "$p" 2>/dev/null || break
        sleep 0.1
    done
    if kill -0 "$p" 2>/dev/null; then
        kill -9 "$p"
    fi
    rm -f "$PIDFILE"
    echo "stopped"
}

serve() {
    local port="${1:-40100}"
    shift || true
    local base="$ANKI_BASE"
    local seed=()
    if [[ "${1:-}" == "--fresh" ]]; then
        base="$ROOT/out/anki-e2e-base"
        rm -rf "$base"
        seed=(--seed 24)
        # Get Shared Decks lists deck files from the Downloads folder; point
        # it at a folder of our own so a test run never reads the real one.
        local downloads="$ROOT/out/anki-e2e-downloads"
        rm -rf "$downloads"
        mkdir -p "$downloads"
        printf 'not a real package' > "$downloads/Example Shared Deck.apkg"
        export ANKI_DOWNLOADS_DIR="$downloads"
    fi
    build_app
    exec "$BIN" --serve "$port" --base "$base" "${seed[@]}"
}

# The main checkout's out/ holds the downloaded toolchain and node_modules;
# a worktree links those and copies the small build products so it can build
# the SvelteKit app and run e2e on its own without ninja.
MAIN_ROOT="/Users/rafe/other/anki"

worktree_init() {
    if [[ "$ROOT" == "$MAIN_ROOT" ]]; then
        echo "already the main checkout"
        return 0
    fi
    mkdir -p "$ROOT/out"
    for d in node_modules pyenv extracted playwright-browsers; do
        [[ -e "$ROOT/out/$d" ]] || ln -s "$MAIN_ROOT/out/$d" "$ROOT/out/$d"
    done
    for d in rslib ts qt sveltekit; do
        [[ -e "$ROOT/out/$d" ]] || cp -R "$MAIN_ROOT/out/$d" "$ROOT/out/$d"
    done
    [[ -e "$ROOT/out/buildhash" ]] || cp "$MAIN_ROOT/out/buildhash" "$ROOT/out/buildhash" 2>/dev/null || true
    [[ -e "$ROOT/node_modules" ]] || ln -s out/node_modules "$ROOT/node_modules"
    echo "worktree ready: $ROOT"
}

sveltekit_build() {
    echo "==> building SvelteKit app"
    (cd "$ROOT/ts" && ../out/extracted/node/bin/node ../out/node_modules/.bin/svelte-kit sync >/dev/null && ../out/extracted/node/bin/node ../out/node_modules/.bin/vite build)
    rm -rf "$ROOT/out/qt/_aqt/data/web/sveltekit"
    mkdir -p "$ROOT/out/qt/_aqt/data/web"
    cp -R "$ROOT/out/sveltekit" "$ROOT/out/qt/_aqt/data/web/sveltekit"
}

e2e_quick() {
    local port="${1:-40100}"
    shift || true
    PLAYWRIGHT_BROWSERS_PATH="$ROOT/out/playwright-browsers" ANKI_DESKTOP_PORT="$port" \
        "$ROOT/out/extracted/node/bin/yarn" playwright test -c playwright.desktop.config.ts "$@"
}

package() {
    local target=()
    local out="$ROOT/target/release/bundle"
    if [[ "${1:-}" == "--universal" ]]; then
        # What the release workflow ships: one bundle for Intel and Apple silicon.
        rustup target add aarch64-apple-darwin x86_64-apple-darwin >/dev/null
        target=(--target universal-apple-darwin)
        out="$ROOT/target/universal-apple-darwin/release/bundle"
    fi
    build_web
    echo "==> building release bundle"
    # There is no Apple developer certificate; "-" seals the bundle with an
    # ad-hoc signature, which macOS accepts once the download flag is cleared.
    APPLE_SIGNING_IDENTITY="${APPLE_SIGNING_IDENTITY:--}" \
        cargo tauri build --config desktop/tauri.conf.json "${target[@]}" 2>&1 | tail -20
    echo "bundle: $out/dmg"
}

# The build happens in GitHub Actions (.github/workflows/desktop-release.yml),
# which tags this commit, attaches the .dmg and publishes the release.
release() {
    local version="${1:-}"
    if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]]; then
        echo "usage: bin/anki release <version>   e.g. bin/anki release 0.2.0" >&2
        return 2
    fi
    local branch
    branch="$(git rev-parse --abbrev-ref HEAD)"
    if [[ -n "$(git status --porcelain)" ]]; then
        echo "working tree is dirty; the release is built from what is pushed" >&2
    fi
    if [[ -n "$(git log --oneline "@{upstream}..HEAD" 2>/dev/null)" ]]; then
        echo "note: $branch has commits that are not pushed; the release is built from origin" >&2
    fi
    gh workflow run desktop-release.yml --ref "$branch" -f version="$version" -f publish=true
    echo "watch it with: gh run watch \$(gh run list --workflow=desktop-release.yml --limit 1 --json databaseId --jq '.[0].databaseId')"
}

# Cold start (process launch to /_anki/readyz) and RPC round trips against a
# fresh seeded collection, using the same binary the app runs.
bench() {
    local port="${1:-40190}"
    build_app
    local base="$ROOT/out/anki-bench-base"
    rm -rf "$base"
    "$BIN" --serve "$port" --base "$base" --seed 200 >/dev/null 2>&1 &
    local pid=$!
    local start_ns
    start_ns=$(python3 -c 'import time; print(time.time_ns())')
    until curl -s -o /dev/null "http://127.0.0.1:$port/_anki/readyz"; do sleep 0.02; done
    local ready_ns
    ready_ns=$(python3 -c 'import time; print(time.time_ns())')
    echo "cold start to ready: $(( (ready_ns - start_ns) / 1000000 )) ms (includes seeding 200 notes)"
    python3 - "$port" <<'PY'
import sys, time, urllib.request
port = sys.argv[1]
def post(method, body=b"", n=50):
    times = []
    for _ in range(n):
        t = time.perf_counter()
        urllib.request.urlopen(urllib.request.Request(f"http://127.0.0.1:{port}/_anki/{method}", data=body, method="POST")).read()
        times.append((time.perf_counter() - t) * 1000)
    times.sort()
    return times[len(times)//2], times[int(len(times)*0.95)]
for method in ["getQueuedCards", "deckTree", "congratsInfo", "studiedToday"]:
    med, p95 = post(method)
    print(f"{method:16s} median {med:6.2f} ms   p95 {p95:6.2f} ms")
t = time.perf_counter(); urllib.request.urlopen(f"http://127.0.0.1:{port}/").read(); print(f"{'index.html':16s} {(time.perf_counter()-t)*1000:6.2f} ms")
PY
    kill "$pid" 2>/dev/null
}

status() {
    if is_running; then
        echo "running (pid $(pid))"
    else
        echo "not running"
        return 1
    fi
}

case "${1:-}" in
    start) shift; start "$@" ;;
    stop) stop ;;
    restart) stop; start --build ;;
    status) status ;;
    build) build_web; build_app ;;
    logs) tail -n 50 -f "$LOG" ;;
    serve) shift; serve "$@" ;;
    e2e) just test-e2e-desktop ;;
    sveltekit) sveltekit_build ;;
    e2e-quick) shift; e2e_quick "$@" ;;
    worktree-init) worktree_init ;;
    package) shift; package "$@" ;;
    release) shift; release "$@" ;;
    bench) shift; bench "$@" ;;
    *)
        sed -n '2,20p' "$0"
        exit 2
        ;;
esac
